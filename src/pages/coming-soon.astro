---
import Base from '~/layouts/Base.astro';
---

<Base title="Coming soon" description="This module hasn't been written yet.">
  <h1 class="text-2xl font-semibold tracking-tight mb-3">Coming soon</h1>
  <p class="max-w-[55ch] text-[15px] leading-relaxed" style="color: var(--color-ink-muted);">
    This module is on the list but hasn't been written yet. Check back later
    or start with one of the modules that's already available.
  </p>
  <p class="mt-6">
    <a href={`${import.meta.env.BASE_URL}/`} class="text-sm" style="color: var(--color-ink-muted);">← All modules</a>
  </p>
</Base>
