---
import Base from '~/layouts/Base.astro';
---

<Base title="Offline">
  <h1 class="text-2xl font-semibold tracking-tight mb-3">Offline</h1>
  <p class="max-w-[55ch] text-[15px] leading-relaxed" style="color: var(--color-ink-muted);">
    You're offline and this page hasn't been visited yet, so there's nothing
    cached for it. Lessons you've already read should still be available —
    try going back to a module you've opened before.
  </p>
  <p class="mt-6">
    <a href={`${import.meta.env.BASE_URL}/`} class="text-sm" style="color: var(--color-ink-muted);">← All modules</a>
  </p>
</Base>
